# Copy to .env and fill in. .env is git-ignored.

# --- LLM (Hugging Face model through the OpenAI-compatible router) ---
HUGGINGFACEHUB_API_TOKEN=
HF_MODEL_ID=Qwen/Qwen2.5-Coder-32B-Instruct
HF_PROVIDER=
HF_BASE_URL=https://router.huggingface.co/v1
HF_MAX_NEW_TOKENS=2000
HF_TEMPERATURE=0.1

# Database flavour the agent writes DDL and picks column types for (prompts only)
DB_DIALECT=PostgreSQL

# --- Local Postgres ---
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
# DDL is generated for / executed against this DB and schema
PG_TARGET_DB=CP_OrderManagement
TARGET_SCHEMA=public
# Generated / executed scripts are logged here in tables named <TABLE_PREFIX>_*

# --- Chat ---
# Number of most recent chat messages sent to the LLM as history
HISTORY_MESSAGES=12
