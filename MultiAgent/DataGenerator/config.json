{
  "units": 10,
  "workers": 10,
  "seed": null,
  "source_rows": 10,

  "primary_key": {"field": "PolicyNumber", "length": 8},

  "database": {"name": "CP_OrderManagement", "schema": "public"},

  "per_key": {
    "default": {"min": 1, "max": 3},
    "PolStakes": {"min": 1, "max": 3}
  },

  "paths": {
    "csv": "../../extPolDetails.csv",
    "field_desc": "../FieldDesc.MD",
    "registry_dump": "../DAGRegistry/registry_dump.json",
    "count_dump": "../DAGRegistry/count_dump.json",
    "mapping": "../XternalLoad/mapping.json",
    "output_dir": "output"
  },

  "faker_locale": "en_IN",
  "faker_default": "word",
  "faker": {
    "PolMaster.ExpirationDate": "future_date:+1y",
    "PolMaster.SumInsured": "random_int:100000:5000000",
    "PolStakes.StakerName": "name",
    "PolStakes.StakerContact.Address": "city",
    "PolStakes.StakerContact.mobile": "phone_number",
    "PolStakes.StakerContact.mail": "email",
    "PolStakes.StakerStatus": "random_element:active,removed"
  }
}
