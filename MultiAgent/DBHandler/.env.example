# Copy to DBHandler/.env and fill in. .env is git-ignored.
# DBHandler is the only folder that connects to a database.

# ===== VECTOR DB: Postgres + pgvector, stores column-profile embeddings (XternalLoad) =====
VECTORDB_HOST=localhost
VECTORDB_PORT=5432
VECTORDB_NAME=vector_db
VECTORDB_USER=postgres
VECTORDB_PASSWORD=
# VECTORDB_TABLE=csv_column_chunks
# VECTORDB_EMBED_DIM=1536          # must match XternalLoad's EMBED_MODEL

# ===== DATA DB: the real tables whose schema / FKs drive generation (DataGenerator) =====
DATADB_HOST=localhost
DATADB_PORT=5432
DATADB_NAME=CP_OrderManagement
DATADB_SCHEMA=public
DATADB_USER=postgres
DATADB_PASSWORD=
