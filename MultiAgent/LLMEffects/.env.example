# Copy to LLMEffects/.env and fill in. .env is git-ignored.
# LLMEffects reads ONLY this file (no fallback to XternalLoad/.env).

# LLM review: Hugging Face router (OpenAI-compatible).
# Request model = HF_MODEL_ID:HF_PROVIDER ; leave HF_PROVIDER empty to let the router pick a provider
# that serves the model (a provider that doesn't serve it -> 400 "model ... not supported by provider").
HUGGINGFACEHUB_API_TOKEN=
HF_MODEL_ID=deepseek-ai/DeepSeek-V4.1-Flash
HF_PROVIDER=
HF_BASE_URL=https://router.huggingface.co/v1
LLMEFFECTS_MAX_TOKENS=6000
HF_TEMPERATURE=0.5
