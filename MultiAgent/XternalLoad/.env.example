# Copy to .env and fill in. .env is git-ignored.
OPENAI_API_KEY=

# Embeddings (default shown; uncomment to override)
# EMBED_MODEL=text-embedding-3-small

# LLM: Hugging Face router (OpenAI-compatible). Request model = HF_MODEL_ID:HF_PROVIDER
HUGGINGFACEHUB_API_TOKEN=
HF_MODEL_ID=Qwen/Qwen2.5-Coder-32B-Instruct
HF_PROVIDER=featherless-ai
HF_BASE_URL=https://router.huggingface.co/v1
HF_MAX_NEW_TOKENS=2000
HF_TEMPERATURE=0.1

# Postgres (database must exist; the pgvector extension is created automatically)
PG_HOST=localhost
PG_PORT=5432
PG_DB=multiagent
PG_USER=postgres
PG_PASSWORD=
