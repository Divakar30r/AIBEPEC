# Copy to .env and fill in. .env is git-ignored.

# --- OpenAI ---
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# Must match the model's output size (text-embedding-3-small = 1536, -large = 3072).
# Changing it requires re-creating the tables.
EMBEDDING_DIM=1536


# --- LLM for evaluation and chat (Hugging Face model via an OpenAI-compatible provider) ---
HUGGINGFACEHUB_API_TOKEN=

# Optional overrides
HF_MODEL_ID=Intelligent-Internet/II-Medical-7B-Preview
HF_TASK=conversational
HF_MAX_NEW_TOKENS=3000
HF_TEMPERATURE=0.2
HF_PROVIDER=featherless-ai

# --- Postgres (on prem, pgvector) ---
PG_HOST=localhost
PG_PORT=5432
PG_DB=vector_db
PG_USER=postgres
PG_PASSWORD=
TABLE_PREFIX=PromptRAG

# --- Sources ---
GIT_REPO_URL=https://github.com/NirDiamant/Prompt_Engineering/tree/main/all_prompt_engineering_techniques
# Optional, only to raise GitHub API rate limits (read-only use).
GITHUB_TOKEN=
PDF_DIR=data/pdfs

# --- Chunking / search ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
CHUNKS_PER_FILE=2
