# Copy to .env and fill in. .env is git-ignored.

# --- OpenAI ---
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# Must match the model's output size (text-embedding-3-small = 1536, -large = 3072).
# Changing it requires re-creating the tables.
EMBEDDING_DIM=1536
# Optional: set to enable LLM-written answers from retrieved chunks. Empty = return top passages.
CHAT_MODEL=

# --- Postgres (on prem, pgvector) ---
PG_HOST=localhost
PG_PORT=5432
PG_DB=vector_db
PG_USER=postgres
PG_PASSWORD=
TABLE_PREFIX=PromptRAG

# --- Sources ---
GIT_REPO_URL=https://github.com/NirDiamant/Prompt_Engineering/tree/main/all_prompt_engineering_techniques
# Optional, only to raise GitHub API rate limits (read-only use).
GITHUB_TOKEN=
PDF_DIR=data/pdfs

# --- Chunking / search ---
# PDFs and prose: paragraph-based recursive splitter
TEXT_CHUNK_SIZE=1000
TEXT_CHUNK_OVERLAP=150
# Python code from git: language-based recursive splitter
CODE_CHUNK_SIZE=1000
CODE_CHUNK_OVERLAP=100
TOP_K=5
