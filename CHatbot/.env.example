# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Hugging Face access token (https://huggingface.co/settings/tokens)
# Required: this is what authenticates calls to HF Inference Providers.
HUGGINGFACEHUB_API_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model repo id served through HF Inference Providers
HF_MODEL_ID=deepseek-ai/DeepSeek-V4.1-Flash

# Inference provider routing.
# "auto" lets Hugging Face pick the best live provider.
# Verified live providers for this model: novita, together, fireworks-ai,
# featherless-ai, baseten, deepinfra
HF_PROVIDER=auto

# Generation defaults
HF_MAX_NEW_TOKENS=512
HF_TEMPERATURE=0.7
HF_REPETITION_PENALTY=1.03
